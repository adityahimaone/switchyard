{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "settings": {
        "chromeFlags": "--no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.25 }],
        "first-contentful-paint": ["error", { "maxNumericValue": 7000 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 8000 }],
        "total-blocking-time": ["error", { "maxNumericValue": 180000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 1750000 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 4700000 }]
      }
    }
  }
}
